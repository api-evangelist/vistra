        {
          "id": "651cb90e-c2a7-43f8-b295-699fecafb73c",
          "name": "Complete Document Upload",
          "request": {
            "name": "Complete Document Upload",
            "description": {
              "content": "Notifies Vistra that a document upload to the pre-signed S3 URL has completed successfully. This endpoint must be called after the file has been uploaded directly to the pre-signed URL. The response confirms the document ID and returns file metadata including filename and size. The document ID is then used when submitting the incorporation request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "external",
                "documents",
                ":id",
                "upload-complete"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The document ID returned by the generate-upload-url endpoint"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
